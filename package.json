{
  "name": "saebom",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:auth": "node --test scripts/check-auth.ts",
    "lint:db": "supabase db lint --fail-on error",
    "check:functions": "deno check supabase/functions/*/index.ts supabase/functions/_shared/*/index.ts && deno lint supabase/functions",
    "format:check": "prettier --check .",
    "test:agents": "node --test \"scripts/agents/*.test.*\"",
    "db:types": "supabase gen types --lang=typescript --local > supabase/functions/_shared/database.types.ts && prettier --write supabase/functions/_shared/database.types.ts",
    "db:seed": "node scripts/seed-catalog.ts",
    "brand:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-brand.ts",
    "invite": "node --env-file=scripts/.env.local scripts/invite.ts",
    "autopilot": "scripts/agents/autopilot.sh",
    "verify": "npm test && npm run test:db && npm run test:auth && npm run lint:db && npm run check:functions && npm --prefix app run typecheck && npm --prefix app run lint && npm run format:check && npm run test:agents"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "vitest": "^5.0.5"
  }
}
