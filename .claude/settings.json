{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(supabase functions deploy*)",
      "Bash(npx supabase functions deploy*)",
      "Bash(supabase link*)",
      "Bash(npx supabase link*)",
      "Bash(supabase login*)",
      "Bash(npx supabase login*)",
      "Bash(supabase secrets *)",
      "Bash(npx supabase secrets *)",
      "Bash(* --linked*)",
      "Bash(* --db-url*)",
      "Bash(npm run invite*)",
      "Bash(npm --prefix app run build:ios*)",
      "Bash(npm --prefix app run submit:ios*)",
      "Bash(eas *)",
      "Bash(npx eas *)",
      "Bash(npx eas-cli *)",
      "Bash(gh pr merge*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(* --no-verify*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Read(~/.supabase/**)",
      "Edit(/scripts/agents/guard.mjs)",
      "Edit(/scripts/agents/guard.test.mjs)",
      "Edit(/scripts/agents/guard-agy.sh)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.agents/hooks.json)",
      "Edit(~/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--no-warnings", "${CLAUDE_PROJECT_DIR}/scripts/agents/guard.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--no-warnings", "${CLAUDE_PROJECT_DIR}/scripts/agents/guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": { "source": "github", "repo": "cursor/plugins" },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  }
}
